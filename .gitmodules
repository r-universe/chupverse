[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "gcomputation"]
	path = gcomputation
	url = https://github.com/chupverse/gcomputation
[submodule "survivalPLANN"]
	path = survivalPLANN
	url = https://github.com/chupverse/survivalplann
[submodule "survivalSL"]
	path = survivalSL
	url = https://github.com/chupverse/survivalsl
